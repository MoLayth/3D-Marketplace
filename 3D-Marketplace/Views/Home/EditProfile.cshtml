@{
	ViewData["Title"] = "Edit Profile";
}
@model UserData
<div class="column-Flex-Container" style="width:100%; height:100%; padding:15px; justify-items:center; gap:10px;">
	<div id="profileImage" class="column-Flex-Container" style="position:relative; padding:2px; background:url('/resources/ProfileCircle.svg');
				height:100px;width:100px; justify-content:center; border-radius:50%;">

		@if (Model != null && Model.ProfilePicture != null) {
			<img id="loadProfileImageBtn" class="image-btn" src="@Model.ProfilePicture" style="width: 100%; height: 100%; object-fit: cover; border-radius:50%; object-position: center;" />
			<img id="removeProfileImage" class="image-btn" src="~/resources/X.svg" style="position:absolute; height: 20px; right:-10px; top:0px;" />
		}
		else {
			<img id="loadProfileImageBtn" class="image-btn" src="/resources/avatar.svg" style="width: 65%; height: 65%; object-fit: fill; object-position: center;" />
			<img id="removeProfileImage" class="image-btn" src="~/resources/X.svg" style="display:none;position:absolute; height: 20px; right:-10px; top:0px;" />
		}
		<input id="loadProfileInput" type="file" style="display:none" accept=".png, .jpg" />
	</div>

	<div class="Row-Flex-Container" style="justify-content:center;">
		<label style="width:130px; text-wrap:nowrap">Display Name:</label>
		<input id="nameInput" type="text" value="@Model?.Name" />
	</div>

	<textarea id="bioInput" style="width:100%; max-width:550px; height:400px" placeholder="Bio">@Model?.Bio</textarea>
	<div class="Row-Flex-Container" style="gap:10px">
		<button id="saveProfileBtn" style="font-size:large; width:150px">Save</button>
		<button id="signOutBtn" style="font-size:large; background:#cd0006; width:150px">SignOut</button>
		<button id="deleteAccountBtn" style="font-size:large; background:#cd0006; width:150px">Delete Account</button>
	</div>
</div>

<script>
	const currentUsername = "@Model?.UserName";
</script>
<script src="/js/EditProfile.js?v=@DateTime.Now.Ticks"></script>
