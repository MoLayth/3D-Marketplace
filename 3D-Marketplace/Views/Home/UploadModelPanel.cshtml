@{
    ViewData["Title"] = "Upload";
    List<string> maps = new() { "Base Color", "Roughness", "Metallic", "Normal-Map", "Emission", "Ambient Occlusion", "HDRI", "Background" };
}
@model ProductData?

<div class="Row-Flex-Container" style="height:100%; padding:10px">
    <div style="display:flex; position:relative; width:450px; height: 100%; flex-shrink:0; overflow:auto">
        <div class="column-Flex-Container" style="position:absolute; width:100%; top:0;left:0; align-items:stretch; color:white; padding-right:10px; gap:15px;">
            <h3 style="text-align:center; border-bottom: 1px solid white;">Texture</h3>
            @foreach (var map in maps) {
                <div class="Row-Flex-Container" style="width:100%">
                    @await Html.PartialAsync("_textureImageField", new ViewDataDictionary(ViewData) { { "Name", map } })
                </div>
            }

            <!------------------------------------------------------------------------------------------------->

            <h3 style="text-align:center; border-bottom: 1px solid white;">Extra</h3>
            <div class="Row-Flex-Container">
                <span style=" text-wrap:nowrap">Emission Brightness</span>
                <div style="flex:2"></div>
                <input id="emissionBrightnessInput" type="number" style="width:30px; text-align:center" value="1" />
            </div>
            <div class="Row-Flex-Container">
                <span style=" text-wrap:nowrap">Emission Color</span>
                <div style="flex:2;"></div>
                <input id="emissionColorInput" type="color" style="width:30px" value="#000000" />
            </div>            
            <div class="Row-Flex-Container">
                <span style=" text-wrap:nowrap">Scene Brightness</span>
                <div style="flex:2"></div>
                <input id="HDMIBrightnessInput" type="number" style="width:30px; text-align:center" value="1" />
            </div>

            <div class="Row-Flex-Container">
                <span style=" text-wrap:nowrap">normalMap Strength</span>
                <div style="flex:2"></div>
                <input id="normalMapStrengthInput" type="number" style="width:30px; text-align:center" value="1" max="5" min="-5"/>
            </div>

            <div class="column-Flex-Container" style="align-items:start">
                <span style="text-wrap:nowrap"> Apply Glass Material To: </span>
                <div class="column-Flex-Container" style="height:100px; width:100%; position:relative; overflow:auto; border: 1px solid white; border-radius:5px;">
                    <div id="MeshesList" class="column-Flex-Container" style="position:absolute; top:0px; left:0px; height:100%; width:100%; align-items:start;padding:5px">
                        <span style="text-wrap:nowrap; color:red"> No Model Currently loaded</span>
                    </div>
                </div>
            </div>

            <!------------------------------------------------------------------------------------------------->

            <h3 style="text-align:center; border-bottom: 1px solid white;">Info</h3>
            <div class="Row-Flex-Container">
                <span style="flex-shrink:0;">Product Name:</span>
                <input id="productName" required type="text" />
            </div>
            <div class="Row-Flex-Container">
                <span style="flex-shrink:0;">product Price:</span>
                <input id="productPrice" type="number" value="0" style="width:50px; text-align:center" />
                <span style="flex-shrink:0;">$</span>

                <div style="flex:1"></div>

                <span style="flex-shrink:0;">Stock:</span>
                <input id="StockInput" type="number" value="0" style="width:50px; text-align:center" />
            </div>
            <span>Description: </span>
            <textarea id="DescriptionInput" style="height:400px"></textarea>
        </div>
    </div>

    <div id="canvas-container" class="canvas" style="width: 100%; height:100%;">        
        <div id="canvas-uploadPanel" class="column-Flex-Container" style="position:absolute; top:50%; left:50%; transform: translateX(-50%) translateY(-50%);">
            <img class="image-btn" id="canvas-upload3dModelBtn" src="~/resources/AddModel.svg" style="height:60px" />
            <input type="file" id="fpxFileInput" style="display:none" accept=".fbx, .glb, .gltf" />
            <span style="color:white"> Select Your 3D Model Of Type FBX/GLTF </span>
            <div style="background:#a20000; border-radius:20px; padding:10px;">All Mesh's Should Have The Same Material!</div>
        </div>

        <div id="canvas-modifyPanel" class="column-Flex-Container" style="position:absolute; right:10px; bottom:10px; align-items:end">
            <div style="justify-items:center;">
                <span style="text-align:center;">Remove Model</span>
                <img class="image-btn" id="canvas-removeModel" src="~/resources/X.svg" />
            </div>

            <div style="height:15px"></div>

            <div style="justify-items:center;">
                <span style="text-align:center;">Save</span>
                <img class="image-btn" id="canvas-Save" style="height:40px" src="~/resources/Save.svg" />
            </div>
            <div style="justify-items:center;">
                <span style="text-align:center;">Set Thumbnail</span>
                <img class="image-btn" id="canvas-takeScreenshot" src="~/resources/screenshot.svg" />
            </div>

            <div style="justify-items:center;">
                <span style="text-align:center;">Reset View </span>
                <img class="image-btn" id="canvas-resetViewButton" src="~/resources/Reset.svg" />
            </div>
        </div>

        <img id="thumbnailImage" style="height:100px; position:absolute; top:10px; right:10px; display:none; border:1px solid white;border-radius:5px;" />
    </div>
    
</div>

<script type="importmap">
    {
        "imports": {
            "three" : "/lib/three/build/three.module.js",
            "three/addons/": "/lib/three/examples/jsm/"
        }
    }
</script>
<script>
        const productId = @(Json.Serialize(Model?.Id ?? -1));
        const isPublished = @(Json.Serialize(Model?.isPublished ?? false));
</script>
<script type="module" src="~/js/UploadModelPanel.js?v=@DateTime.Now.Ticks"></script>
