<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]-3D_Marketplace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-layout">
    <div class="Row-Flex-Container" style="padding:10px; background:#1B1B1B">
        <img src="~/resources/3D-Marketplace.png" style="height:40px" />
        <div style="flex:2"></div>
        <img class="image-btn" src="~/resources/upload2.svg" />
    </div>

    <div class="main-wrapper" style="background: #292929;">
        <main role="main" style="height:100%;">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
