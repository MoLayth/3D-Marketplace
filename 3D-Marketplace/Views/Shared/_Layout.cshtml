<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]-3D_Marketplace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="site-layout">
    <div class="Row-Flex-Container" style="padding:10px; background:#1B1B1B">
        <img src="~/resources/3D-Marketplace.png" style="height:40px" />
        <div style="flex:2"></div>
        <img class="image-btn" src="~/resources/upload2.svg" />

        @if (!string.IsNullOrEmpty(ViewData["Name"]?.ToString())) {
            <span>@ViewData["Name"]</span>

            string img = "/resources/avatar.svg";
            if (!string.IsNullOrEmpty(ViewData["ProfilePic"]?.ToString())){
                img = ViewData["ProfilePic"].ToString();
            }

            <img class="image-btn" src="@img" style="height: 40px" onclick="showEditProfilePanel()" />
        }
        else {
            <img class="image-btn" src="~/resources/avatar.svg" style="height: 40px" onclick="showSignPanel()" />            
        }
    </div>

    <div class="main-wrapper">
        <main role="main" style="height:100%;">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("_WarningMessage");

    <div class="closePanel blur-panel" id="SignPanel" targetPanelId="SignPanel" style="display:none; position:absolute; width:100%; height:100%;">
        <div class="floating-panel" onclick="event.stopPropagation()">
            <div class="column-Flex-Container" style="position:relative">
                <img src="~/resources/3D-Marketplace.png" style="height:40px" />
                <div style="height:20px"></div>
                @await Html.PartialAsync("_UsernameField")
                @await Html.PartialAsync("_PasswordField")
                <div class="Row-Flex-Container" style="gap:10px">
                    <button id="createAccountBtn" style="font-size:large; background:#cd0006">Create Account</button>
                    <button id="SignInBtn" style="font-size:large; background:#cd0006">Sign In</button>
                </div>
                <img class="image-btn closePanel" targetPanelId="SignPanel" src="/resources/X.svg" style="height:30px; position:absolute; right:-40px; top:-40px" />
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
