@{
    string labelText = ViewData["labelText"]?.ToString() ?? "Password:";
    // this is very important if you have multiple password in the cshtml you should give each one it one id even if you don't need to use it
    string inputId = ViewData["inputId"]?.ToString() ?? "password";
    string iconId = ViewData["iconId"]?.ToString() ?? "showPasswordIcon";
    string name = ViewData["name"]?.ToString() ?? ""; // this is very important for a form
}

<div class="Row-Flex-Container">
    <label for="@inputId" class="field-label" style="width:130px">@labelText</label>
    <input id="@inputId" class="field-input" type="password" name="@name" required>
    <img class="image-btn" id="@iconId" src="~/resources/hiden.svg" style="width:40px; height:40px" />
</div>

<script>
    // the IIFE improtent becouse it create a private sandbox for each password field. The variables and events inside it will never leak or overwrite each other.
    (() =>{
        const passwordInput = document.getElementById("@inputId");
        const passwordIcon = document.getElementById("@iconId");

        passwordInput.addEventListener("input",(e) =>{
            const input = e.target;
            const cursorPosition = input.selectionStart;

            if (input.value.includes(' ')) {
                input.value = input.value.replace(' ', "");

                const newPosition = cursorPosition - 1;
                input.setSelectionRange(newPosition, newPosition); // fixing the text cart problem
            };
        });
        passwordIcon.addEventListener("click",(e)=>{
            if(passwordInput.type === "password"){
                passwordInput.type = "text";
                passwordIcon.src = "/resources/visible.svg"

            }else{
                passwordInput.type = "password";
                passwordIcon.src = "/resources/hiden.svg"
            }
        })
    })();

</script>